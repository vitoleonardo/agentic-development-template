{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm run format *)",
      "Bash(npm run build *)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format *)",
      "Bash(pnpm build *)",
      "Bash(pnpm test *)",
      "Bash(pnpm run typecheck *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm run format *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm exec tsc --noEmit *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(pnpm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Edit(.github/**)",
      "Edit(package-lock.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(migrations/**)",
      "Edit(Dockerfile*)",
      "Edit(docker-compose*)",
      "Edit(compose.yaml)",
      "Edit(compose.yml)",
      "Edit(infra/**)",
      "Edit(terraform/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/rules/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(.npmrc)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(source .env*)",
      "Bash(. .env*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git clean *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(printenv *)",
      "Bash(env)"
    ]
  }
}
