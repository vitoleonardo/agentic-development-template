#!/bin/sh
# PostToolBatch: once per batch of tool calls, format the edited source files,
# then run the typecheck and the tests related to them. Failures go back to
# Claude as context so it fixes them in the same turn.
. "$(dirname -- "$0")/lib.sh"

pending=$(state_file pending)
[ -s "$pending" ] || exit 0
batch="$pending.$$"
mv "$pending" "$batch" || exit 0

files=$(sort -u "$batch" | while IFS= read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done)
rm -f "$batch"
[ -n "$files" ] || exit 0

log=$(state_file checks)
failures=""
export NO_COLOR=1 FORCE_COLOR=0 CI=1

run() {
  name=$1
  shift
  started=$(date +%s)
  out=$(.claude/bin/check "$name" "$@" 2>&1)
  code=$?
  seconds=$(($(date +%s) - started))
  case $code in
    0) result=pass ;;
    3) return 0 ;; # not configured for this stack
    *) result=fail ;;
  esac
  printf '%s %s %ss\n' "$name" "$result" "$seconds" >>"$log"
  if [ "$result" = fail ]; then
    failures="$failures
== $name failed (exit $code) ==
$(printf '%s\n' "$out" | tail -n 40)"
  fi
}

# Files are passed one per argument; names with spaces stay intact.
set -f
old_ifs=$IFS
IFS='
'
# shellcheck disable=SC2086
set -- $files
IFS=$old_ifs
set +f

run format "$@"
run typecheck
run test-related "$@"

[ -z "$failures" ] && exit 0

message="Checks failed after editing: $*
If you just wrote a test that is meant to fail first (red before green), record the failure in the state file and continue. Otherwise fix the cause before moving on.
$failures"

printf '{"hookSpecificOutput":{"hookEventName":"PostToolBatch","additionalContext":"%s"}}\n' \
  "$(printf '%s\n' "$message" | json_escape)"
exit 0
