#!/bin/sh
# Stop: after a turn that changed files, show the user what changed and which
# checks ran. If the last run of a check failed, keep Claude working once.
. "$(dirname -- "$0")/lib.sh"

turn_files=$(state_file turn-files)
log=$(state_file checks)
[ -s "$turn_files" ] || [ -s "$log" ] || exit 0

# The last result of each check this turn decides whether it is still red.
red=""
if [ -s "$log" ]; then
  red=$(awk '{ last[$1] = $2 } END { for (c in last) if (last[c] == "fail") printf "%s ", c }' "$log")
fi

if [ -n "$red" ] && ! json_bool stop_hook_active; then
  printf '{"decision":"block","reason":"%s"}\n' \
    "$(printf 'These checks are still failing: %s. Fix them, or tell the user plainly why they stay red (for example a test written to fail first).' "$red" | json_escape)"
  exit 0
fi

changed=$(sort -u "$turn_files" 2>/dev/null)
count=$(printf '%s\n' "$changed" | grep -c .)
listed=$(printf '%s\n' "$changed" | head -n 10 | tr '\n' ' ')
[ "$count" -gt 10 ] && listed="$listed(+$((count - 10)) more)"

checks="none"
if [ -s "$log" ]; then
  checks=$(awk '{ runs[$1]++; last[$1] = $2 } END { for (c in runs) printf "%s %s (%d runs), ", c, last[c], runs[c] }' "$log" | sed 's/, $//')
fi

rm -f "$turn_files" "$log"
printf '{"systemMessage":"%s"}\n' \
  "$(printf 'Changed %s file(s): %s\nChecks: %s' "$count" "$listed" "$checks" | json_escape)"
exit 0
