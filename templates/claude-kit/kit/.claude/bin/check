#!/bin/sh
# Run one project check as defined by the stack adapter in .claude/kit.conf.
# Usage: .claude/bin/check <typecheck|lint|test|test-related|format|build> [files...]
# Exit codes: the check's own code, 2 for usage or setup errors, 3 when the check is not configured.
set -u

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd) || exit 2
cd "$root" || exit 2

conf=.claude/kit.conf
if [ ! -f "$conf" ]; then
  echo "check: $conf is missing. Copy a stack adapter into the project (see the kit README)." >&2
  exit 2
fi
# shellcheck source=/dev/null
. "./$conf"

name=${1:-}
[ $# -gt 0 ] && shift
case $name in
  typecheck) cmd=${KIT_TYPECHECK:-} ;;
  lint) cmd=${KIT_LINT:-} ;;
  test) cmd=${KIT_TEST:-} ;;
  test-related) cmd=${KIT_TEST_RELATED:-} ;;
  format) cmd=${KIT_FORMAT:-} ;;
  build) cmd=${KIT_BUILD:-} ;;
  *)
    echo "usage: .claude/bin/check <typecheck|lint|test|test-related|format|build> [files...]" >&2
    exit 2
    ;;
esac

if [ -z "$cmd" ]; then
  echo "check: '$name' is not configured in $conf." >&2
  exit 3
fi

# Files are passed as separate arguments, so names with spaces stay intact.
exec sh -c "$cmd"' "$@"' check "$@"
