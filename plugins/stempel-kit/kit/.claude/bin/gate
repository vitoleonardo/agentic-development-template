#!/bin/sh
set -u

gates="spec plan deps split config commit push"
name=${1:-}
case " $gates level round " in
  *" $name "*) ;;
  *)
    echo "usage: .claude/bin/gate <$(printf '%s' "$gates" | tr ' ' '|')>   prints ask or auto" >&2
    echo "       .claude/bin/gate level   prints strict (the default), standard or autonomous" >&2
    echo "       .claude/bin/gate round <kit|test|hotfix|spec> <n>   prints whether failed verify round n continues (auto) or asks" >&2
    exit 2
    ;;
esac

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd) || exit 2
gate_variable=KIT_GATE_$(printf '%s' "$name" | tr a-z A-Z)
gate_value() { eval "printf '%s' \"\${$gate_variable:-}\""; }

# The environment wins over kit.conf for the level, the gate's own override, the verify rounds and the push patterns.
env_level=${KIT_APPROVAL:-} env_rounds=${KIT_VERIFY_ROUNDS:-} env_gate=$(gate_value) env_push_ask=${KIT_PUSH_ASK_PATTERNS:-}
# shellcheck source=/dev/null
[ ! -f "$root/.claude/kit.conf" ] || . "$root/.claude/kit.conf"
conf_gate=$(gate_value)

level=${env_level:-${KIT_APPROVAL:-strict}}
case $level in
  strict | standard | autonomous) ;;
  *) echo "gate: KIT_APPROVAL='$level' is not strict, standard or autonomous; using strict." >&2; level=strict ;;
esac

if [ "$name" = round ]; then
  # A failed verify round n of a class: kit false positives never count, spec changes always ask, and test and
  # hotfix rounds continue up to their KIT_VERIFY_ROUNDS limit; at autonomous they continue past it.
  class=${2:-} n=${3:-}
  case $n in '' | *[!0-9]*) class=usage ;; esac
  rounds=${env_rounds:-${KIT_VERIFY_ROUNDS:-}}
  limit=$(printf '%s\n' "test:3 hotfix:2 $rounds" | tr ' ' '\n' | sed -n "s/^$class:\([0-9][0-9]*\)$/\1/p" | tail -n 1)
  case $class in
    kit) echo auto ;;
    spec) echo ask ;;
    test | hotfix) if [ "$n" -le "$limit" ] || [ "$level" = autonomous ]; then echo auto; else echo ask; fi ;;
    *) echo "usage: .claude/bin/gate round <kit|test|hotfix|spec> <verify round>" >&2; exit 2 ;;
  esac
  exit 0
fi
[ "$name" != level ] || { echo "$level"; exit 0; }

override=${env_gate:-$conf_gate}
case $override in
  ask | auto) echo "$override"; exit 0 ;;
  '') ;;
  *) echo "gate: $gate_variable='$override' is not ask or auto; using KIT_APPROVAL=$level." >&2 ;;
esac

# by_risk: the extension stempel-kit-risk ranks the plan (at autonomous) and the push (at standard) with
# .claude/bin/risk <plan|push>; exit 1 (high) asks a person. Without the extension, or when risk cannot rank
# (exit 2), a person approves every plan and a push decides itself.
by_risk() {
  out=$(cd "$root" && { [ -x .claude/bin/risk ] || exit 3; } && KIT_PUSH_ASK_PATTERNS=$env_push_ask .claude/bin/risk "$name" 2>&1)
  code=$?
  if [ "$code" -eq 0 ] || { [ "$code" -ne 1 ] && [ "$name" = push ]; }; then echo auto; return; fi
  [ -n "$out" ] || out="no risk rank ($([ "$code" -eq 3 ] && echo "stempel-kit-risk is not installed" || echo ".claude/bin/risk exit $code"))"
  printf '%s\n' "$out" | sed "s/^/gate $name: /" >&2
  echo "gate $name: a person approves this $name (.claude/bin/risk)." >&2
  echo ask
}

case $level:$name in
  strict:* | standard:spec | standard:plan) echo ask ;;
  autonomous:plan | standard:push) by_risk ;;
  *) echo auto ;;
esac
