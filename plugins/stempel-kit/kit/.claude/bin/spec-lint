#!/bin/sh
# Check that feature specs meet the kit's standard for acceptance criteria.
# Usage: .claude/bin/spec-lint [spec files...]   (default: every specs/*.md except specs/README.md)
# Prints file:line: problem for each finding and exits 1 if there is any.
set -u

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd) || exit 2
cd "$root" || exit 2
# shellcheck source=criteria.sh
. "$root/.claude/bin/criteria.sh"
[ $# -gt 0 ] || set -- specs/*.md

# status_of <spec>: the spec's status in specs/README.md (draft, review, approved, ...), lowercase.
status_of() {
  [ -f specs/README.md ] || return 0
  grep -F "${1##*/}" specs/README.md | head -n 1 | awk -F'|' '{ gsub(/[[:space:]`]/, "", $4); print tolower($4) }'
}

failed=0 checked=0
for file in "$@"; do
  case $file in */README.md | README.md) continue ;; esac
  [ -f "$file" ] || continue
  checked=$((checked + 1))
  awk -v file="$file" -v status="$(status_of "$file")" "$CRITERION_CHECK"'
    function problem(line, message) { printf "%s:%d: %s\n", file, line, message; bad = 1 }

    BEGIN { criterion_check_init(); nrequired = split("Goal|User flow|Acceptance criteria|Edge cases|Out of scope", need, "|") }

    /^ID prefix:/ {
      prefix = $0; sub(/^ID prefix:[[:space:]]*/, "", prefix); sub(/[[:space:]]+$/, "", prefix)
      if (prefix !~ /^[A-Z][A-Z0-9]*$/) problem(NR, "ID prefix must be uppercase letters and digits, like INVITE.")
      next
    }
    /^## / { section = substr($0, 4); sub(/[[:space:]]+$/, "", section); seen[section] = 1; next }
    section != "" && /^[[:space:]]*(-|[0-9]+\.)[[:space:]]/ { items[section]++ }

    (section == "Acceptance criteria" || section == "Edge cases") && /^-[[:space:]]/ {
      if ($0 !~ /^- \*\*[^*]+\*\*/) { problem(NR, "every criterion starts with its bold ID, like - **" (prefix ? prefix : "FEATURE") "-AC1**: Given ..."); next }
      id = $0; sub(/^- \*\*/, "", id); sub(/\*\*.*$/, "", id)
      rest = $0; sub(/^- \*\*[^*]+\*\*/, "", rest)
      if (prefix == "") problem(NR, "the spec needs an \"ID prefix: <NAME>\" line before the criteria.")
      else if (id !~ ("^" prefix "-AC[0-9]+$")) problem(NR, id ": IDs look like " prefix "-AC<number>.")
      if (id in line_of) problem(NR, id ": already used on line " line_of[id] "; IDs are never reused.")
      line_of[id] = NR
      criteria++
      if (rest ~ /^[[:space:]]*\(removed/) next
      if (section == "Edge cases") edge++
      sub(/^:[[:space:]]*/, "", rest)
      check_criterion(NR, id, rest)
      next
    }
    section == "Open questions" && /^-[[:space:]]/ { if (tolower($0) !~ /^-[[:space:]]*(none|n\/a|-)\.?[[:space:]]*$/) open_questions++ }

    END {
      if (prefix == "" && !bad) problem(1, "missing the \"ID prefix: <NAME>\" line.")
      for (i = 1; i <= nrequired; i++) if (!(need[i] in seen)) problem(NR, "missing the \"## " need[i] "\" section.")
      if (("User flow" in seen) && !items["User flow"]) problem(NR, "the User flow section lists no steps.")
      if (("Out of scope" in seen) && !items["Out of scope"]) problem(NR, "Out of scope is empty; name at least one thing this feature does not do.")
      if (!criteria) problem(NR, "no acceptance criteria found.")
      if (("Edge cases" in seen) && !edge) problem(NR, "no edge cases; cover at least errors, empty data or missing permissions.")
      if (status != "" && status != "draft" && open_questions)
        problem(NR, "status is \"" status "\" but " open_questions " open question(s) remain; resolve them before approval.")
      exit bad
    }
  ' "$file" || failed=1
done

[ "$checked" -gt 0 ] || { echo "spec-lint: no specs to check."; exit 0; }
[ "$failed" -eq 0 ] && echo "spec-lint: $checked spec(s) pass."
exit "$failed"
