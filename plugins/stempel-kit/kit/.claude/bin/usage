#!/bin/sh
# Token usage of the current branch's work, recorded by the usage hook in .work/<branch>/.
# Usage:
#   .claude/bin/usage total     tokens counted against KIT_BUDGET_TOKENS
#   .claude/bin/usage report    per tier and per agent, escalations and review rounds
#   .claude/bin/usage line      the one line for the PR description, with the branch's cache hit rate
#   .claude/bin/usage cache     the cache hit rate per agent and for the branch: cache reads over every token sent
#   .claude/bin/usage cost <feature>   what the feature's autopilot sessions cost, per phase and in total
#   .claude/bin/usage tsv       one line for .claude/bin/runs: total, fast, standard, deep, main, other tokens,
#                               review rounds, escalations, tasks, cache hit rate (TAB separated)
#   .claude/bin/usage tokens <transcript>       "<model> TAB <input> TAB <output> TAB <cache read> TAB <cache write>" per model
#   .claude/bin/usage add-killed <transcript>   count a session the runner killed, from its transcript
#   .claude/bin/usage reviews   tokens per review round: "<round> TAB <tokens>", from the "review round <n>" dispatches
#   .claude/bin/usage adopt <branch>   move another branch's record here (spec and plan run before the branch exists)
# usage.tsv:  <agent id or main:<session id>> TAB <model> TAB <input> TAB <output> TAB <cache read> TAB <cache write>
# agents.tsv: <agent id> TAB <description> TAB <agent type> TAB <requested model> TAB <resolved model>
# The budget counts input, output and cache writes. Cache reads are left out: they are cheap and grow with
# every turn of a long session, so counting them would make any budget meaningless. The cache hit rate is cache
# reads over input, cache reads and cache writes, rounded down; KIT_CACHE_MIN_PERCENT names a rate below it.
# Session cost comes from .work/autopilot/sessions.tsv (total_cost_usd per session), never from a price table.
set -u

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd) || exit 2
cd "$root" || exit 2
if [ -f .claude/kit.conf ]; then
  # shellcheck source=/dev/null
  . ./.claude/kit.conf
fi
branch=$(git branch --show-current 2>/dev/null)
dir=${USAGE_DIR:-.work/${branch:-detached}}
usage=$dir/usage.tsv
agents=$dir/agents.tsv

# tokens <transcript>: "<model> TAB <input> TAB <output> TAB <cache read> TAB <cache write>" per model.
transcript_tokens() {
  [ -f "$1" ] || return 0
  awk '
    function num(s, key) { return match(s, "\"" key "\":[0-9]+") ? substr(s, RSTART + length(key) + 3, RLENGTH - length(key) - 3) + 0 : 0 }
    /"parent_tool_use_id":"/ { next }
    /"type":"assistant"/ && match($0, /"usage":\{/) {
      u = substr($0, RSTART, 1500)
      id = match($0, /"id":"msg_[^"]*"/) ? substr($0, RSTART, RLENGTH) : "line" NR
      model = match($0, /"model":"[^"]*"/) ? substr($0, RSTART + 9, RLENGTH - 10) : "unknown"
      if (model == "<synthetic>") next
      if (!(id in seen)) order[++n] = id
      seen[id] = 1; m[id] = model
      in_[id] = num(u, "input_tokens"); out[id] = num(u, "output_tokens")
      cr[id] = num(u, "cache_read_input_tokens"); cw[id] = num(u, "cache_creation_input_tokens")
    }
    END {
      for (i = 1; i <= n; i++) { id = order[i]; k = m[id]; a[k] += in_[id]; b[k] += out[id]; c[k] += cr[id]; d[k] += cw[id] }
      for (k in a) printf "%s\t%d\t%d\t%d\t%d\n", k, a[k], b[k], c[k], d[k]
    }
  ' "$1"
}

ticked=$(awk '{ sub(/\r$/, "") } /^## / { inside = ($0 == "## Progress"); next } inside && /^- \[[xX]\] [0-9]/ && !/^- \[[xX]\] [0-9]+[ \t]+<[^<>]*>[ \t]*$/ { n++ } END { print n + 0 }' ".work/${branch:-detached}.md" 2>/dev/null || echo 0)

# The tier a model ID belongs to, from the aliases in kit.conf ("main" for the session itself).
tiers="fast=${KIT_MODEL_FAST:-haiku} standard=${KIT_MODEL_STANDARD:-sonnet} deep=${KIT_MODEL_DEEP:-opus}"

case ${1:-} in
  tokens) transcript_tokens "${2:?usage: usage tokens <transcript>}" ;;
  add-killed)
    # A killed session may never reach its Stop hook, so its tokens come from the transcript the runner kept. They go
    # on the session's own line, as the hook's do, so they count once. A resumed session's transcript holds only its
    # last segment, so per model and field the larger number stands.
    [ -f "${2:-}" ] || exit 0
    mkdir -p "$dir"
    id=$(sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$2" | head -n 1 | tr -cd 'A-Za-z0-9_-')
    key=main:${id:-killed-$(basename "$2" .jsonl)}
    { [ ! -f "$usage" ] || cat "$usage"; transcript_tokens "$2" | sed "s/^/$key$(printf '\t')/"; } |
      awk -F '\t' -v OFS='\t' -v key="$key" '
        $1 != key { print; next }
        !($2 in seen) { seen[$2] = 1; order[++n] = $2 }
        { for (i = 3; i <= 6; i++) if ($i + 0 > best[$2, i] + 0) best[$2, i] = $i + 0 }
        END { for (j = 1; j <= n; j++) { m = order[j]; print key, m, best[m, 3] + 0, best[m, 4] + 0, best[m, 5] + 0, best[m, 6] + 0 } }
      ' >"$usage.$$"
    mv "$usage.$$" "$usage"
    ;;
  total)
    [ -f "$usage" ] || { echo 0; exit 0; }
    awk -F '\t' '{ s += $3 + $4 + $6 } END { print s + 0 }' "$usage"
    ;;
  cache)
    [ -f "$usage" ] || { echo "No usage recorded for ${branch:-this branch} yet."; exit 0; }
    awk -F '\t' '
      function rate(reads, sent) { return sent > 0 ? int(reads * 100 / sent) "%" : "–" }
      {
        sent = $3 + $5 + $6
        rows = rows sprintf("| %s | %s | %s |\n", ($1 ~ /^main(:|$)/ ? "main" : $1), $2, rate($5, sent))
        all_reads += $5; all_sent += sent
      }
      END {
        print "| Agent | Model | Cache hit rate |"
        print "|-------|-------|----------------|"
        printf "%s", rows
        printf "| branch | – | %s |\n", rate(all_reads, all_sent)
      }
    ' "$usage"
    ;;
  cost)
    feature=${2:?usage: usage cost <feature>}
    sessions=.work/autopilot/sessions.tsv
    if [ ! -f "$sessions" ] || ! awk -F '\t' -v f="$feature" 'NR > 1 && $2 == f { found = 1 } END { exit !found }' "$sessions"; then
      echo "No session costs recorded for $feature."
      exit 0
    fi
    awk -F '\t' -v f="$feature" '
      NR > 1 && $2 == f {
        if ($7 ~ /^[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?$/) {
          if (!($3 in by)) order[++n] = $3
          by[$3] += $7; total += $7
        } else without++
      }
      END {
        for (i = 1; i <= n; i++) printf "%s %.2f USD\n", order[i], by[order[i]]
        if (without == 1) print "1 session without a cost"
        else if (without > 1) printf "%d sessions without a cost\n", without
        printf "total %.2f USD\n", total
      }
    ' "$sessions"
    ;;
  report | line | tsv)
    if [ ! -f "$usage" ]; then
      [ "$1" = tsv ] && printf '0\t0\t0\t0\t0\t0\t0\t0\t%d\t–\n' "$ticked" || echo "No usage recorded for ${branch:-this branch} yet."
      exit 0
    fi
    min_percent=${KIT_CACHE_MIN_PERCENT:-}
    case $min_percent in
      '' | *[!0-9]*)
        if [ -n "$min_percent" ] && [ "$1" != tsv ]; then
          echo "usage: KIT_CACHE_MIN_PERCENT='$min_percent' is not a whole number; the cache hit rate is shown without a minimum." >&2
        fi
        min_percent=""
        ;;
    esac
    awk -F '\t' -v tiers="$tiers" -v mode="$1" -v agents="$agents" -v ticked="$ticked" -v min_percent="$min_percent" '
      BEGIN {
        n = split(tiers, t, " ")
        for (i = 1; i <= n; i++) { split(t[i], kv, "="); alias[kv[1]] = kv[2]; order[i] = kv[1] }
        while ((getline line < agents) > 0) {
          split(line, a, "\t"); desc[a[1]] = a[2]
          if (tolower(a[2]) ~ /(retry|escalat)/) esc++
          if (tolower(a[3]) ~ /reviewer$/ && tolower(a[2]) !~ /screenshot/) rounds++
          if (match(tolower(a[2]), /^task [0-9]+/) && !((k = substr(tolower(a[2]), 1, RLENGTH)) in task)) { task[k] = 1; tasks++ }
        }
      }
      function tier(model, agent,    i) {
        if (agent ~ /^main(:|$)/) return "main"
        for (i = 1; i <= n; i++) if (index(model, alias[order[i]]) > 0) return order[i]
        return "other"
      }
      {
        tk = $3 + $4 + $6; tr = tier($2, $1)
        by[tr] += tk; total += tk
        reads += $5; sent += $3 + $5 + $6
        if ($1 !~ /^main(:|$)/) rows = rows sprintf("| %s | %s | %s | %d | %d | %d | %d |\n", $1, (desc[$1] == "" ? "–" : desc[$1]), $2, $3, $4, $5, $6)
      }
      END {
        hit = (sent > 0) ? int(reads * 100 / sent) : -1
        if (mode == "tsv") {
          printf "%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%s\n", total, by["fast"], by["standard"], by["deep"], by["main"], by["other"], rounds, esc, (ticked ? ticked : tasks), (hit >= 0 ? hit : "–")
          exit
        }
        line = "Tokens (input + output + cache writes): " total + 0
        for (i = 1; i <= n; i++) if (by[order[i]] > 0) line = line ", " order[i] " " by[order[i]]
        if (by["main"] > 0) line = line ", main session " by["main"]
        if (by["other"] > 0) line = line ", other " by["other"]
        line = line ". Review rounds: " rounds + 0 ". Escalations: " esc + 0 "."
        if (hit >= 0) {
          line = line " Cache hit rate: " hit "%"
          if (min_percent != "" && hit < min_percent + 0) line = line ", below " min_percent "%"
          line = line "."
        }
        if (mode == "line") { print line; exit }
        print line
        print ""
        print "| Agent | Task | Model | Input | Output | Cache read | Cache write |"
        print "|-------|------|-------|-------|--------|------------|-------------|"
        printf "%s", rows
      }
    ' "$usage"
    ;;
  reviews)
    [ -f "$usage" ] && [ -f "$agents" ] || exit 0
    awk -F '\t' '
      NR == FNR { if (match(tolower($2), /^review round [0-9]+/)) round[$1] = substr($2, 14, RLENGTH - 13) + 0; next }
      $1 in round { tokens[round[$1]] += $3 + $4 + $6 }
      END { for (r in tokens) printf "%d\t%d\n", r, tokens[r] }
    ' "$agents" "$usage" | sort -n
    ;;
  adopt)
    from=.work/${2:?usage: usage adopt <branch>}
    [ "$from" != "$dir" ] || exit 0
    mkdir -p "$dir"
    for f in usage.tsv agents.tsv; do
      [ -f "$from/$f" ] || continue
      # Lines for the same agent or session are recomputed totals; the newer record wins.
      if [ -f "$dir/$f" ]; then
        awk -F '\t' 'NR == FNR { seen[$1] = 1; print; next } !($1 in seen)' "$dir/$f" "$from/$f" >"$dir/$f.new" && mv "$dir/$f.new" "$dir/$f"
      else
        cp "$from/$f" "$dir/$f"
      fi
      rm -f "$from/$f"
    done
    echo "Moved the usage record of ${2} to ${branch}."
    ;;
  *) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
