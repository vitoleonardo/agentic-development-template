# The baseline (.claude/bin/baseline): check --against-baseline blocks only new failures.
# JUnit XML report that KIT_TEST writes, relative to the package; the baseline reads test IDs from it.
KIT_TEST_REPORT=""
# Commands that read KIT_COVERAGE's report: per file "<file> TAB <covered lines> TAB <total lines>",
# and the overall line percentage. $KIT_BIN is the root's .claude/bin, where adapter helpers live.
KIT_COVERAGE_FILES=""
KIT_COVERAGE_PCT=""
# Shell patterns of source files that never carry coverage, for example "*.d.ts". Files matching the test patterns
# or KIT_E2E_PATTERNS are never measured.
KIT_COVERAGE_EXCLUDE=""
# Percent of the lines in the changed source files that tests must cover, and how many points
# overall coverage may drop below the baseline.
KIT_COVERAGE_THRESHOLD="70"
KIT_COVERAGE_TOLERANCE="0.5"
