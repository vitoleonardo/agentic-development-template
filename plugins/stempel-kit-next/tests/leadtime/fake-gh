#!/bin/sh
# A stand-in for gh in the leadtime tests: serves prs.json, keeping the PRs merged in the queried period,
# and applies --jq with jq (gh's built-in --jq is gojq, which accepts the same expression).
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
case "$1 $2" in
  "repo view") printf 'acme/shop\tmain\n'; exit 0 ;;
  "api graphql") ;;
  *) echo "fake-gh: unexpected call: $*" >&2; exit 1 ;;
esac
shift 2
expr="" q=""
while [ $# -gt 0 ]; do
  case $1 in
    --jq) expr=$2; shift 2 ;;
    -F) case $2 in q=*) q=${2#q=} ;; esac; shift 2 ;;
    -f) shift 2 ;;
    *) shift ;;
  esac
done
range=$(printf '%s' "$q" | sed -n 's/.*merged:\([0-9-]*\)\.\.\([0-9-]*\).*/\1 \2/p')
from=${range% *} to=${range#* }
printf '%s\n' "$q" >>"${FAKE_GH_LOG:-/dev/null}"
jq --arg from "$from" --arg to "$to" '.data.search.nodes |= map(select(.mergedAt[0:10] >= $from and .mergedAt[0:10] <= $to))' "$here/prs.json" |
  jq -r "$expr"
