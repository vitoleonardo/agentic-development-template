#!/bin/sh
# Evidence pack for /verify-feature: the parts a script can decide, so the model only writes the judgements.
# Usage:
#   .claude/bin/evidence gates [--only a,b]    run every hard gate (or only the named ones, for a round that reruns
#                                              what failed; json refuses that pack); write gates.md and gates.tsv
#   .claude/bin/evidence scope <commit>        whether a later round covers the commits since <commit> or the whole branch
#   .claude/bin/evidence matrix                check edge-cases.md: every case has a passing test or "n/a: <reason>"
#   .claude/bin/evidence data [--all]          run KIT_SEED + the affected e2e tests and KIT_TEST_MOCKED; write data-runs.md
#   .claude/bin/evidence screenshots [--no-base] [--all]   screenshots of the affected tests, on the branch and the base
#   .claude/bin/evidence e2e-select [--all]    print which e2e tests the change needs: all, related (with files) or none
#   .claude/bin/evidence json                  assemble evidence.json from the parts
#   .claude/bin/evidence push [--pr N]         push the pack to the kit-evidence branch under <pr-N|branch>/<head sha>/
#   .claude/bin/evidence ci-check --head SHA --key KEY...   CI: the pushed pack exists for SHA and names it
#   .claude/bin/evidence comment --dir DIR --repo OWNER/NAME --key KEY   print the PR comment for a pack
# The pack lives in .work/<branch>/evidence/ (EVIDENCE_DIR overrides it). See docs/SPEC-v1.1.md, section 4.
# --all runs the whole e2e suite; CI does that after every merge to catch what the selection missed.
set -u

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd) || exit 2
cd "$root" || exit 2
KIT_ROOT=$root
export KIT_ROOT NO_COLOR=1 FORCE_COLOR=0 CI=${CI:-1}
# shellcheck source=conf.sh
. "$root/.claude/bin/conf.sh"
[ -f .claude/kit.conf ] || { echo "evidence: .claude/kit.conf is missing." >&2; exit 2; }

branch=$(git branch --show-current 2>/dev/null)
dir=${EVIDENCE_DIR:-.work/${branch:-detached}/evidence}
tab=$(printf '\t')
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

protected() { conf_value . KIT_PROTECTED_PATHS; }
excludes() { for p in $(protected); do printf ':(exclude)%s\n' "${p%/}"; done; }
now() { date +%s; }

# json_str <text>: a JSON string literal.
json_str() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\t\n' '  ')"
}

# --- gates ---------------------------------------------------------------------

# gate <name> <result> <seconds> <detail>: record one gate.
gate() {
  want "$1" || return 0
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$(printf '%s' "$4" | tr '\t\n' '  ' | cut -c1-300)" >>"$dir/gates.tsv"
  printf '| %s | %s | %ss | %s |\n' "$1" "$2" "$3" "$(printf '%s' "$4" | tr '|\n' '/ ' | cut -c1-300)" >>"$tmp/gates-table"
  [ "$2" = fail ] && [ -s "$tmp/log-$1" ] && { printf '\n### %s\n\n```text\n' "$1"; tail -n 40 "$tmp/log-$1"; printf '```\n'; } >>"$tmp/gates-logs"
  [ "$2" = fail ] && failed="$failed $1"
  return 0
}

# check_gate <name> <check arguments...>: a gate run through .claude/bin/check; n/a passes with its reason,
# "not configured" fails (a hard gate has to be configured or say why not).
check_gate() {
  want "$1" || return 0
  name=$1
  shift
  started=$(now)
  .claude/bin/check "$@" >"$tmp/log-$name" 2>&1
  code=$?
  secs=$(($(now) - started))
  summary=$(grep -E '^(tests|lint|typecheck|coverage) in |n/a:|not configured|legacy|flaky|new clones' "$tmp/log-$name" | head -n 3 | tr '\n' ';')
  if [ "$code" -eq 0 ] && grep -q 'is required\.$' "$tmp/log-$name"; then
    gate "$name" fail "$secs" "printed a value below its threshold but exited 0; $summary"
    return
  fi
  case $code in
    0) gate "$name" pass "$secs" "$summary" ;;
    4) gate "$name" n/a "$secs" "$(grep -o 'n/a:.*' "$tmp/log-$name" | head -n 1)" ;;
    3) gate "$name" fail "$secs" "not configured: set the command in kit.conf, or n/a: <reason>" ;;
    *) gate "$name" fail "$secs" "exit $code; $summary" ;;
  esac
}

# diff_all [git diff options]: the diff since the merge base including untracked files, without protected paths.
diff_all() {
  # shellcheck disable=SC2046
  git diff "$@" "$(merge_base)" -- . $(excludes) 2>/dev/null
  # shellcheck disable=SC2046
  git ls-files --others --exclude-standard -- . $(excludes) 2>/dev/null | while IFS= read -r f; do
    git diff --no-index "$@" -- /dev/null "$f" 2>/dev/null
  done
  return 0
}

# Added lines of the diff since the merge base, without protected paths: "<file> TAB <line>".
added_lines() {
  diff_all -U0 | awk '
    /^\+\+\+ / { f = substr($0, 7); next }
    /^\+/ { print f "\t" substr($0, 2) }'
}

# deps <file content on stdin> <manifest name>: dependency names declared in a manifest.
deps() {
  case $1 in
    package.json)
      awk '
        /"(dependencies|devDependencies|peerDependencies|optionalDependencies)"[[:space:]]*:[[:space:]]*\{/ { inside = 1; next }
        inside && /\}/ { inside = 0; next }
        inside && match($0, /"[^"]+"[[:space:]]*:/) { s = substr($0, RSTART + 1, RLENGTH - 1); sub(/"[[:space:]]*:$/, "", s); print s }'
      ;;
    pyproject.toml)
      awk '
        /^(dependencies|[a-zA-Z0-9_-]+)[[:space:]]*=[[:space:]]*\[/ && (section ~ /^(project|dependency-groups|project\.optional-dependencies)$/) { inside = 1 }
        /^\[/ { section = $0; gsub(/[][]/, "", section); inside = 0; next }
        inside { while (match($0, /"[A-Za-z0-9_.-]+/)) { print tolower(substr($0, RSTART + 1, RLENGTH - 1)); $0 = substr($0, RSTART + RLENGTH) } }
        inside && /\]/ { inside = 0 }'
      ;;
    requirements*.txt)
      sed -e 's/#.*//' -e 's/[[:space:]]//g' | grep -v '^-' | sed -E 's/[<>=!~;[].*//' | tr 'A-Z' 'a-z' | grep .
      ;;
  esac | sort -u
}

# gitleaks_config: a gitleaks config with the project's rules and one path-and-value allowlist per row of
# .claude/secrets-allow.tsv whose value is no key format.
gitleaks_config() {
  if [ -f .gitleaks.toml ]; then printf '[extend]\npath = "%s"\n' "$root/.gitleaks.toml"; else printf '[extend]\nuseDefault = true\n'; fi
  [ -f .claude/secrets-allow.tsv ] || return 0
  grep -v '^#' .claude/secrets-allow.tsv | while IFS="$tab" read -r path value; do
    [ -n "$path" ] && [ -n "$value" ] || continue
    printf '%s' "$value" | grep -Eq "$key_format" && continue
    printf "\n[[allowlists]]\ncondition = \"AND\"\nregexTarget = \"match\"\npaths = ['''^%s\$''']\nregexes = ['''%s''']\n" \
      "$(regex_escape "$path")" "$(regex_escape "$value")"
  done
}

regex_escape() { printf '%s' "$1" | sed 's/[][\\.^$*+?(){}|]/\\&/g'; }

all_gates="typecheck lint build test coverage duplicates structure focus red dependencies protected secrets size"

# want <gate>: true unless gates --only leaves the gate out.
want() {
  [ -z "${only:-}" ] && return 0
  case " $only " in *" $1 "*) return 0 ;; esac
  return 1
}

gates() {
  only=""
  if [ "${1:-}" = --only ]; then
    only=$(printf '%s' "${2:-}" | tr ',' ' ')
    for g in $only; do
      case " $all_gates " in *" $g "*) ;; *) echo "evidence gates: unknown gate '$g'; the gates are: $all_gates" >&2; return 2 ;; esac
    done
    [ -n "$only" ] || { echo "evidence gates: --only needs gate names, for example --only secrets,coverage" >&2; return 2; }
  fi
  mkdir -p "$dir"
  : >"$dir/gates.tsv"
  : >"$tmp/gates-table"
  : >"$tmp/gates-logs"
  failed=""
  check_gate typecheck --against-baseline typecheck
  check_gate lint --against-baseline lint
  check_gate build build
  check_gate test --against-baseline test
  check_gate coverage --against-baseline coverage
  check_gate duplicates duplicates

  started=$(now)
  .claude/bin/structure >"$tmp/log-structure" 2>&1
  code=$?
  summary=$(tail -n 1 "$tmp/log-structure")
  case $code in
    0) gate structure pass $(($(now) - started)) "$summary" ;;
    3) gate structure fail 0 "not configured: no Map in .claude/rules/structure.md" ;;
    *) gate structure fail $(($(now) - started)) "$summary" ;;
  esac

  added_lines >"$tmp/added"
  focus='(^|[^[:alnum:]_])((it|test|describe|context|suite)\.(only|skip|todo)[[:space:]]*\(|(xit|xdescribe|xtest|fit|fdescribe)[[:space:]]*\(|@pytest\.mark\.(skip|skipif|xfail)|@unittest\.skip|pytest\.skip[[:space:]]*\()'
  grep -E "$focus" "$tmp/added" >"$tmp/log-focus"
  if [ -s "$tmp/log-focus" ]; then gate focus fail 0 "focus or skip added: $(cut -f1 "$tmp/log-focus" | sort -u | tr '\n' ' ')"; else gate focus pass 0 "no .only, .skip or skip markers added"; fi
  red

  plan=.work/${branch:-detached}.md
  approved=$(sed -n 's/^- *Approved dependencies: *//p' "$plan" 2>/dev/null | head -n 1 | tr ',' ' ' | tr 'A-Z' 'a-z')
  : >"$tmp/log-dependencies"
  mb=$(merge_base)
  git diff --name-only "$mb" -- 2>/dev/null | grep -E '(^|/)(package\.json|pyproject\.toml|requirements[^/]*\.txt)$' | while IFS= read -r m; do
    [ -f "$m" ] || continue
    kind=${m##*/}
    git show "$mb:$m" 2>/dev/null | deps "$kind" >"$tmp/old"
    deps "$kind" <"$m" >"$tmp/new"
    comm -13 "$tmp/old" "$tmp/new" | while IFS= read -r d; do
      case " $approved " in *" $(printf '%s' "$d" | tr 'A-Z' 'a-z') "*) ;; *) printf '%s: %s\n' "$m" "$d" ;; esac
    done
  done >"$tmp/log-dependencies"
  if [ -s "$tmp/log-dependencies" ]; then
    gate dependencies fail 0 "not in the plan's Approved dependencies: $(cut -d' ' -f2 "$tmp/log-dependencies" | tr '\n' ' ')"
  else
    gate dependencies pass 0 "no new dependency outside the plan's approved list (${approved:-none})"
  fi

  : >"$tmp/log-protected"
  protected_list=$(protected)
  for p in $protected_list; do
    git diff --name-only "$mb" -- "${p%/}" 2>/dev/null
    git ls-files --others --exclude-standard -- "${p%/}" 2>/dev/null
  done >"$tmp/log-protected"
  if [ -s "$tmp/log-protected" ]; then gate protected fail 0 "files changed in protected paths: $(tr '\n' ' ' <"$tmp/log-protected")"; else gate protected pass 0 "no protected path changed (${protected_list:-none configured})"; fi

  # .claude/secrets-allow.tsv lists approved fake values as "<path> TAB <exact value>"; it never covers a key format.
  key_format='(-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9_-]{20,})'
  if command -v gitleaks >/dev/null 2>&1; then
    # The branch's commits, so findings keep their paths for the allowlist; uncommitted changes through stdin.
    gitleaks_config >"$tmp/gitleaks.toml"
    pathspecs=". $(excludes | tr '\n' ' '):(exclude)reports/runs"
    gitleaks git --no-banner --redact -c "$tmp/gitleaks.toml" --log-opts "$mb..HEAD -- $pathspecs" . >"$tmp/log-secrets" 2>&1
    code=$?
    # shellcheck disable=SC2046
    git diff HEAD -- . $(excludes) ':(exclude)reports/runs' >"$tmp/uncommitted"
    if [ -s "$tmp/uncommitted" ]; then
      gitleaks stdin --no-banner --redact -c "$tmp/gitleaks.toml" <"$tmp/uncommitted" >>"$tmp/log-secrets" 2>&1 || code=1
    fi
    if [ "$code" -eq 0 ]; then gate secrets pass 0 "gitleaks: no leaks in the branch's commits"; else gate secrets fail 0 "gitleaks found secrets (redacted in the log)"; fi
  else
    # Without gitleaks, key formats fail and "name = value" matches only warn: fake values in tests and seeds
    # match them too.
    grep -v '^reports/runs/' "$tmp/added" >"$tmp/added-scanned"
    assignment='(api[_-]?key|secret|token|password)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'[:space:]]{12,}'
    grep -Ei "$key_format" "$tmp/added-scanned" | cut -f1 | sort -u >"$tmp/log-secrets"
    git diff --name-only --diff-filter=A "$mb" -- 2>/dev/null | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -vE '\.env\.(example|sample|template)$' >>"$tmp/log-secrets"
    grep -Ei "$assignment" "$tmp/added-scanned" | awk -F '\t' -v allowed=.claude/secrets-allow.tsv '
      BEGIN { while ((getline line < allowed) > 0) if (line !~ /^#/ && split(line, f, "\t") >= 2) { n++; path[n] = f[1]; value[n] = f[2] } }
      { for (i = 1; i <= n; i++) if (path[i] == $1 && index($2, value[i])) next; print $1 }' | sort -u >"$tmp/warn-secrets"
    gap="setup gap: gitleaks not installed"
    if [ -s "$tmp/log-secrets" ]; then
      gate secrets fail 0 "key formats or a new .env file (pattern scan, $gap): $(tr '\n' ' ' <"$tmp/log-secrets")"
    elif [ -s "$tmp/warn-secrets" ]; then
      gate secrets pass 0 "warning: possible secrets in $(tr '\n' ' ' <"$tmp/warn-secrets")(name = value pattern, $gap). Approved fake values go into .claude/secrets-allow.tsv"
    else
      gate secrets pass 0 "pattern scan, $gap: no key formats, no name = value matches"
    fi
  fi

  max=$(conf_value . KIT_MAX_CHANGED_LINES)
  max=${max:-400}
  changed=$(diff_all --numstat | awk '$3 !~ /(^|\/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|uv\.lock)$|\.snap$/ {
    total += ($1 == "-" ? 0 : $1) + ($2 == "-" ? 0 : $2) } END { print total + 0 }')
  if [ "$changed" -gt $((max * 2)) ]; then gate size fail 0 "$changed changed lines, more than twice the limit of $max; split the change"
  elif [ "$changed" -gt "$max" ]; then gate size pass 0 "warning: $changed changed lines, above the limit of $max"
  else gate size pass 0 "$changed changed lines (limit $max)"; fi

  {
    printf '# Hard gates\n\nHead %s, base %s (%s).\n\n' "$(git rev-parse --short HEAD)" "$(base_ref)" "$(git rev-parse --short "$mb")"
    [ -n "$only" ] && printf 'Partial run (--only %s): not an evidence pack. Run every gate at the final commit.\n\n' "$only"
    printf '| Gate | Result | Time | Detail |\n|------|--------|------|--------|\n'
    cat "$tmp/gates-table"
    [ -s "$tmp/gates-logs" ] && { printf '\n## Output\n'; cat "$tmp/gates-logs"; }
  } >"$dir/gates.md"
  if [ -n "$only" ]; then printf '%s\n' "$only" >"$dir/gates.partial"; else rm -f "$dir/gates.partial"; fi
  if want test; then
    # The test gate's flaky tests go into the pack.
    sed -n 's/^  flaky (passed on the rerun): //p' "$tmp/log-test" >"$dir/flaky.txt" 2>/dev/null
    # The JUnit reports of this run, so the matrix can check test names against what actually ran.
    : >"$dir/tests.tsv"
    for pkg in $(packages); do
      report=$(conf_value "$pkg" KIT_TEST_REPORT)
      [ -n "$report" ] && [ -f "$pkg/$report" ] && .claude/bin/baseline junit "$pkg/$report" >>"$dir/tests.tsv"
    done
  fi
  cat "$tmp/gates-table"
  if [ -n "$failed" ]; then
    echo "Failed gates:$failed. Details in $dir/gates.md."
    return 1
  fi
  echo "All hard gates passed. Details in $dir/gates.md."
}

# --- red: criterion tests must fail without the change ------------------------------

# base_tree <dir>: a worktree of the merge base with the branch's kit.conf, for runs on the base.
base_tree() {
  git worktree add -q --detach "$1" "$(merge_base)" || return 1
  cp .claude/kit.conf "$1/.claude/kit.conf" 2>/dev/null
  return 0
}

# in_base <dir> <command>: run a command in a folder of the base worktree with the variables of KIT_BASE_ENV, an env
# file that is read for this run and never copied. An empty command does nothing.
in_base() {
  [ -n "$2" ] || return 0
  base_env=$(conf_value . KIT_BASE_ENV)
  case $base_env in '' | /*) ;; *) base_env=$root/$base_env ;; esac
  # shellcheck source=/dev/null
  (cd "$1" && { [ -z "$base_env" ] || { set -a && . "$base_env" && set +a; }; } && sh -c "$2") </dev/null
}

# red: a criterion test proves the change only if it fails without it. The test files whose added lines name a
# criterion (<FEATURE>-AC<n>) are copied onto the merge base, set up with KIT_SETUP, and run there with KIT_TEST and
# the files appended. A test that passes there and whose title is on an added line proves nothing. Exceptions:
# "- <test title> | <reason>" under "## Red exceptions" in .work/<branch>.md. It warns only, for now.
red() {
  want red || return 0
  started=$(now)
  grep -E '[A-Z][A-Z0-9_]*-AC[0-9]+' "$tmp/added" >"$tmp/red-lines"
  cut -f1 "$tmp/red-lines" | sort -u | while IFS= read -r f; do
    [ -f "$f" ] || continue
    pkg=$(package_of "$f")
    if matches_any "$f" "$(test_patterns "$pkg")"; then printf '%s\t%s\n' "$pkg" "$f"; fi
  done >"$tmp/red-files"
  if [ ! -s "$tmp/red-files" ]; then gate red pass 0 "no test file adds a criterion test"; return 0; fi
  wt=$tmp/red-base
  if ! base_tree "$wt" >"$tmp/log-red" 2>&1; then gate red pass 0 "warning: no worktree of the base, not checked"; return 0; fi
  if ! in_base "$wt" "$(conf_value . KIT_SETUP)" >>"$tmp/log-red" 2>&1; then
    git worktree remove --force "$wt"
    gate red pass $(($(now) - started)) "warning: KIT_SETUP failed on the base, not checked"
    return 0
  fi
  : >"$tmp/red-passing"
  notes=""
  for pkg in $(cut -f1 "$tmp/red-files" | sort -u); do
    cmd=$(conf_value "$pkg" KIT_TEST)
    report=$(conf_value "$pkg" KIT_TEST_REPORT)
    case $cmd in '' | n/a:*) notes="$notes; $pkg: no KIT_TEST"; continue ;; esac
    [ -n "$report" ] || { notes="$notes; $pkg: no KIT_TEST_REPORT"; continue; }
    awk -F '\t' -v p="$pkg" '$1 == p { f = $2; if (p != ".") f = substr(f, length(p) + 2); print f }' "$tmp/red-files" >"$tmp/red-pkg"
    while IFS= read -r f; do
      mkdir -p "$wt/$pkg/$(dirname -- "$f")"
      cp "$pkg/$f" "$wt/$pkg/$f"
    done <"$tmp/red-pkg"
    rm -f "$wt/$pkg/$report"
    in_base "$wt/$pkg" "$cmd $(quoted "$tmp/red-pkg")" >>"$tmp/log-red" 2>&1
    if [ ! -f "$wt/$pkg/$report" ]; then notes="$notes; $pkg: the base run wrote no $report"; continue; fi
    .claude/bin/baseline junit "$wt/$pkg/$report" | awk -F '\t' '$2 == "pass" { print $1 }' >>"$tmp/red-passing"
  done
  git worktree remove --force "$wt"
  sed -n '/^## Red exceptions[[:space:]]*$/,/^## /s/^- *\([^|]*[^|[:space:]]\)[[:space:]]*|.*/\1/p' ".work/${branch:-detached}.md" >"$tmp/red-exceptions" 2>/dev/null
  awk -F '\t' -v lines="$tmp/red-lines" -v except="$tmp/red-exceptions" '
    BEGIN {
      while ((getline l < lines) > 0) { split(l, f, "\t"); added[++n] = f[2] }
      while ((getline l < except) > 0) skip[l] = 1
    }
    {
      name = $0; sub(/.*::/, "", name)
      k = split(name, parts, " > "); title = parts[k]
      if (title !~ /[A-Z][A-Z0-9_]*-AC[0-9]+/ || (title in skip)) next
      for (i = 1; i <= n; i++) if (index(added[i], title)) { print title; next }
    }' "$tmp/red-passing" | sort -u >"$tmp/red-unproven"
  secs=$(($(now) - started))
  files=$(wc -l <"$tmp/red-files" | tr -d ' ')
  if [ -s "$tmp/red-unproven" ]; then
    gate red pass "$secs" "warning: pass without the change: $(tr '\n' ';' <"$tmp/red-unproven")$notes (strengthen the test, or list it under ## Red exceptions with a reason)"
  else
    gate red pass "$secs" "the criterion tests of $files files fail on the base$notes"
  fi
}

# --- matrix --------------------------------------------------------------------

# edge-cases.md holds one table: | Criterion | Case | Input | Expected | Test | Result |
# The Test cell names a test (as in its title) or says "n/a: <reason>". The script fills in the result.
matrix() {
  file=$dir/edge-cases.md
  [ -f "$file" ] || { echo "evidence: $file is missing; write the matrix first." >&2; return 2; }
  [ -s "$dir/tests.tsv" ] || { echo "evidence: no test results in $dir/tests.tsv; run 'evidence gates' first." >&2; return 2; }
  awk -F '|' -v results="$dir/tests.tsv" '
    function trim(s) { gsub(/^[[:space:]`]+|[[:space:]`]+$/, "", s); return s }
    BEGIN { while ((getline line < results) > 0) { n = split(line, f, "\t"); status[f[1]] = f[2] } }
    /^\|/ && NF >= 7 {
      c = trim($2); kase = trim($3); test = trim($6)
      if (c == "Criterion" || c ~ /^-+$/) next
      if (test ~ /^n\/a:[[:space:]]*[^[:space:]]/) { r = "n/a" }
      else if (test == "" || test == "-" || test ~ /^n\/a:?[[:space:]]*$/) { r = "fail: no test"; bad = 1 }
      else {
        r = "fail: no test named like this ran"
        for (id in status) if (index(id, test) > 0) { r = status[id] == "pass" ? "pass" : "fail: " status[id]; if (status[id] == "pass") break }
        if (r != "pass") bad = 1
      }
      printf "%s\t%s\t%s\t%s\n", c, kase, test, r
    }
    END { exit bad }
  ' "$file" >"$dir/matrix.tsv"
  result=$?
  awk -F '\t' '{ printf "%-12s %-40s %s\n", $1, substr($2, 1, 40), $4 }' "$dir/matrix.tsv"
  [ -s "$dir/matrix.tsv" ] || { echo "evidence: no rows in $file." >&2; return 1; }
  if [ "$result" -ne 0 ]; then echo "Matrix: cases without a passing test. A case without a test is a failure, not a note."; fi
  return "$result"
}

# --- e2e selection -------------------------------------------------------------

# changed_files: the files changed since the merge base, untracked ones included, without protected paths.
changed_files() {
  # shellcheck disable=SC2046
  { git diff --name-only "$(merge_base)" -- . $(excludes); git ls-files --others --exclude-standard -- . $(excludes); } 2>/dev/null | sort -u
}

# quoted <file>: the lines of a file as single-quoted shell words, for appending to a command.
quoted() { sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/" "$1" | tr '\n' ' '; }

# e2e_select [--all]: which e2e tests the change since the merge base needs. Prints "<mode>: <reason>" and, for
# "related", one test file per line. all runs KIT_E2E, related runs KIT_E2E_RELATED with the files, none runs nothing.
# Related tests are the changed e2e files plus the e2e files that name a feature (SHOP in SHOP-AC1) whose criterion
# IDs the diff adds. Whatever the selection cannot vouch for runs everything.
e2e_select() {
  [ "${1:-}" = --all ] && { echo "all: --all"; return; }
  [ -n "$(conf_value . KIT_E2E_RELATED)" ] || { echo "all: KIT_E2E_RELATED is not set"; return; }
  e2e_patterns=$(conf_value . KIT_E2E_PATTERNS)
  [ -n "$e2e_patterns" ] || { echo "all: KIT_E2E_PATTERNS is not set"; return; }
  full=$(conf_value . KIT_E2E_FULL_PATTERNS)
  test_patterns=$(conf_value . KIT_TEST_PATTERNS)
  changed_files >"$tmp/changed"
  : >"$tmp/selected"
  other=""
  while IFS= read -r f; do
    if [ -n "$full" ] && matches_any "$f" "$full"; then echo "all: $f changed"; return; fi
    if matches_any "$f" "$e2e_patterns"; then
      [ -f "$f" ] && printf '%s\n' "$f" >>"$tmp/selected"
    elif ! matches_any "$f" "$test_patterns"; then
      case $f in *.md) ;; *) other=$f ;; esac
    fi
  done <"$tmp/changed"
  features=""
  if [ -n "$other" ]; then
    # Only tests and docs changed: their own e2e files are enough. Otherwise add the features the diff names.
    features=$(diff_all -U0 | grep '^+' | grep -v '^+++' | grep -oE '[A-Z][A-Z0-9]*-AC[0-9]+' | sed 's/-AC[0-9]*$//' | sort -u | tr '\n' ' ')
    if [ -n "$features" ]; then
      # shellcheck disable=SC2046
      git ls-files --cached --others --exclude-standard -- . $(excludes) | while IFS= read -r f; do
        matches_any "$f" "$e2e_patterns" && [ -f "$f" ] &&
          grep -qE "(^|[^A-Z0-9])($(printf '%s' "$features" | sed 's/ *$//; s/ /|/g'))-AC[0-9]" "$f" && printf '%s\n' "$f"
      done >>"$tmp/selected"
    fi
  fi
  sort -u "$tmp/selected" -o "$tmp/selected"
  if [ -s "$tmp/selected" ]; then
    echo "related: $(wc -l <"$tmp/selected" | tr -d ' ') e2e test files (changed e2e files${features:+, features ${features% }})"
    cat "$tmp/selected"
  elif [ -n "$other" ]; then
    echo "all: $other changed and no e2e test names a criterion of this change"
  else
    echo "none: only tests and docs changed"
  fi
}

# e2e_command <command key> <related key> [--all]: the command for the selection, or "n/a: <reason>" for none.
# The selection stays in $tmp/selection; its first line is the reason.
e2e_command() {
  e2e_select "${3:-}" >"$tmp/selection"
  case $(head -n 1 "$tmp/selection") in
    none:*) printf 'n/a: %s' "$(head -n 1 "$tmp/selection" | sed 's/^none: //')" ;;
    related:*)
      related=$(conf_value . "$2")
      if [ -z "$related" ]; then conf_value . "$1"; return; fi
      tail -n +2 "$tmp/selection" >"$tmp/selected-files"
      printf '%s %s' "$related" "$(quoted "$tmp/selected-files")"
      ;;
    *) conf_value . "$1" ;;
  esac
}

# --- data runs -----------------------------------------------------------------

# run_step <name> <command> [label]: the label defaults to the last "seed:" or "mocked:" line the command prints.
run_step() {
  name=$1 cmd=$2
  started=$(now)
  (sh -c "$cmd" </dev/null) >"$tmp/log-$name" 2>&1
  code=$?
  secs=$(($(now) - started))
  label=${3:-$(grep -E '^(seed|mocked):' "$tmp/log-$name" | tail -n 1)}
  result=pass
  [ "$code" -eq 0 ] || result=fail
  printf '%s\t%s\t%s\t%s\n' "$name" "$result" "$secs" "$label" >>"$dir/data-runs.tsv"
  printf '| %s | %s | %ss | `%s` | %s |\n' "$name" "$result" "$secs" "$cmd" "$label" >>"$tmp/data-table"
  [ "$result" = fail ] && { printf '\n### %s\n\n```text\n' "$name"; tail -n 40 "$tmp/log-$name"; printf '```\n'; } >>"$tmp/data-logs"
  [ "$code" -eq 0 ]
}

# e2e_results: the KIT_E2E_REPORT results of this run replace the e2e rows of tests.tsv (third field "e2e"), so the
# matrix counts cases that only an e2e test covers.
e2e_results() {
  [ -f "$dir/tests.tsv" ] || return 0
  grep -v "${tab}e2e\$" "$dir/tests.tsv" >"$tmp/tests"
  for pkg in $(packages); do
    report=$(conf_value "$pkg" KIT_E2E_REPORT)
    [ -n "$report" ] && [ -f "$pkg/$report" ] && .claude/bin/baseline junit "$pkg/$report" | sed "s/\$/${tab}e2e/" >>"$tmp/tests"
  done
  cp "$tmp/tests" "$dir/tests.tsv"
}

# run_resources: the test stack's own database, Redis db and port from kit.conf, for the seed, e2e and screenshot
# commands, so parallel runs and other suites do not share state.
run_resources() {
  KIT_RUN_DB=$(conf_value . KIT_RUN_DB) KIT_RUN_REDIS_DB=$(conf_value . KIT_RUN_REDIS_DB) KIT_RUN_PORT=$(conf_value . KIT_RUN_PORT)
  export KIT_RUN_DB KIT_RUN_REDIS_DB KIT_RUN_PORT
}

data() {
  run_resources
  mkdir -p "$dir"
  : >"$dir/data-runs.tsv"
  : >"$tmp/data-table"
  : >"$tmp/data-logs"
  status=0
  seed=$(conf_value . KIT_SEED)
  e2e=$(conf_value . KIT_E2E)
  case $e2e in '' | n/a:*) ;; *) e2e=$(e2e_command KIT_E2E KIT_E2E_RELATED "${1:-}") ;; esac
  mocked=$(conf_value . KIT_TEST_MOCKED)
  for pair in "seed:$seed" "e2e:$e2e" "mocked:$mocked"; do
    name=${pair%%:*} cmd=${pair#*:}
    case $cmd in
      '') printf '%s\tnot configured\t0\t\n' "$name" >>"$dir/data-runs.tsv"; printf '| %s | not configured | – | – | – |\n' "$name" >>"$tmp/data-table" ;;
      n/a:*) printf '%s\tn/a\t0\t%s\n' "$name" "$cmd" >>"$dir/data-runs.tsv"; printf '| %s | %s | – | – | – |\n' "$name" "$cmd" >>"$tmp/data-table" ;;
      *)
        if [ "$name" = e2e ] && grep -q "^seed${tab}fail" "$dir/data-runs.tsv"; then
          printf 'e2e\tfail\t0\tnot run: the seed failed\n' >>"$dir/data-runs.tsv"; status=1; continue
        fi
        label=""
        if [ "$name" = e2e ]; then
          label=$(head -n 1 "$tmp/selection")
          for pkg in $(packages); do
            report=$(conf_value "$pkg" KIT_E2E_REPORT)
            [ -n "$report" ] && rm -f "$pkg/$report"
          done
        fi
        run_step "$name" "$cmd" "$label" || status=1
        [ "$name" = e2e ] && e2e_results
        ;;
    esac
  done
  {
    printf '# Data runs\n\nSeeded: `KIT_SEED` then `KIT_E2E`. Mocked: `KIT_TEST_MOCKED`. The seed version and the mock set are the last `seed:` and `mocked:` lines the commands print.\n\n'
    printf '| Run | Result | Time | Command | Seed, mock set or e2e selection |\n|-----|--------|------|---------|---------------------------------|\n'
    cat "$tmp/data-table"
    [ -s "$tmp/data-logs" ] && { printf '\n## Failures\n'; cat "$tmp/data-logs"; }
  } >"$dir/data-runs.md"
  cat "$tmp/data-table"
  return "$status"
}

# --- screenshots ---------------------------------------------------------------

# base_lacks <merge base>: the features (SHOP in SHOP-AC1) whose criterion IDs the diff adds, when no e2e test
# file on the base names any of them; empty when the base has one of them or the diff names none.
base_lacks() {
  e2e_patterns=$(conf_value . KIT_E2E_PATTERNS)
  [ -n "$e2e_patterns" ] || return 0
  features=$(diff_all -U0 | grep '^+' | grep -v '^+++' | grep -oE '[A-Z][A-Z0-9]*-AC[0-9]+' | sed 's/-AC[0-9]*$//' | sort -u | tr '\n' ' ')
  [ -n "$features" ] || return 0
  git ls-tree -r --name-only "$1" | while IFS= read -r f; do matches_any "$f" "$e2e_patterns" && printf '%s\n' "$f"; done >"$tmp/base-e2e"
  if [ -s "$tmp/base-e2e" ]; then
    # shellcheck disable=SC2046
    git grep -qE "(^|[^A-Z0-9])($(printf '%s' "$features" | sed 's/ *$//; s/ /|/g'))-AC[0-9]" "$1" -- $(cat "$tmp/base-e2e") && return 0
  fi
  printf '%s' "${features% }"
}

# KIT_SCREENSHOTS writes <AC-ID>-<step>-<desktop|mobile><KIT_SCREENSHOT_SUFFIX>.png into $KIT_SCREENSHOT_DIR.
screenshots() {
  run_resources
  with_base=1 all=""
  for arg; do
    case $arg in --no-base) with_base=0 ;; --all) all=--all ;; esac
  done
  cmd=$(conf_value . KIT_SCREENSHOTS)
  case $cmd in '' | n/a:*) ;; *) cmd=$(e2e_command KIT_SCREENSHOTS KIT_SCREENSHOTS_RELATED "$all") ;; esac
  case $cmd in
    '' | n/a:*) echo "screenshots: ${cmd:-not configured}"; mkdir -p "$dir"; printf '%s\n' "${cmd:-not configured}" >"$dir/screenshots.txt"; return 0 ;;
  esac
  shots=$(mkdir -p "$dir/screenshots" && cd "$dir/screenshots" && pwd)
  rm -f "$shots"/*.png
  echo "screenshots on $(git branch --show-current)"
  if ! KIT_SCREENSHOT_DIR=$shots KIT_SCREENSHOT_SUFFIX="" sh -c "$cmd" </dev/null; then
    echo "screenshots: KIT_SCREENSHOTS failed on the branch." >&2
    return 1
  fi
  if [ "$with_base" -eq 0 ]; then
    printf 'taken; base: not run (--no-base)\n' >"$dir/screenshots.txt"
  elif missing=$(base_lacks "$(merge_base)") && [ -n "$missing" ]; then
    echo "screenshots on the base: n/a: base has no $missing"
    printf 'taken; base: n/a: base has no %s\n' "$missing" >"$dir/screenshots.txt"
  else
    # The same flow on the base: a worktree of the merge base, set up with KIT_SETUP (for example the install).
    wt=$tmp/base
    base_tree "$wt" || return 1
    echo "screenshots on the base ($(git rev-parse --short "$(merge_base)"))"
    if in_base "$wt" "$(conf_value . KIT_SETUP)" &&
      (export KIT_SCREENSHOT_DIR="$shots" KIT_SCREENSHOT_SUFFIX=".main" && in_base "$wt" "$cmd"); then
      printf 'taken; base: taken\n' >"$dir/screenshots.txt"
    else
      echo "screenshots: the base run failed; pages that do not exist there have no .main image." >&2
      printf 'taken; base: the run failed\n' >"$dir/screenshots.txt"
    fi
    git worktree remove --force "$wt"
  fi
  ls "$shots" | sed 's/^/  /'
  [ -n "$(ls "$shots")" ] || { echo "screenshots: KIT_SCREENSHOTS wrote no images." >&2; return 1; }
}

# --- scope of a later round -----------------------------------------------------

# scope <since>: whether a later review or verify round may cover only the commits since <since> ("delta") or must
# cover the whole branch again ("full"): when the fixes are more than 20% of the branch's diff, or touch a file in
# KIT_CONTRACT_PATTERNS (auth, migrations, public routes).
scope() {
  since=${1:?usage: evidence scope <commit the last round ran on>}
  git rev-parse -q --verify "$since^{commit}" >/dev/null || { echo "evidence scope: $since is not a commit." >&2; return 2; }
  # shellcheck disable=SC2046
  if contract=$(changed_file_matching "$since" "${KIT_CONTRACT_PATTERNS:-$(conf_value . KIT_CONTRACT_PATTERNS)}" . $(excludes)); then
    echo "full: $contract is a contract file (KIT_CONTRACT_PATTERNS)"
    return 0
  fi
  lockfiles='(^|/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|uv\.lock)$|\.snap$'
  total=$(diff_all --numstat | awk -v skip="$lockfiles" '$3 !~ skip { t += ($1 == "-" ? 0 : $1) + ($2 == "-" ? 0 : $2) } END { print t + 0 }')
  # shellcheck disable=SC2046
  fixes=$(git diff --numstat "$since" -- . $(excludes) | awk -v skip="$lockfiles" '$3 !~ skip { t += ($1 == "-" ? 0 : $1) + ($2 == "-" ? 0 : $2) } END { print t + 0 }')
  pct=$(awk -v f="$fixes" -v t="$total" 'BEGIN { print (t == 0 ? 0 : int(f * 100 / t)) }')
  if [ "$pct" -gt 20 ]; then
    echo "full: the fixes are $pct% of the diff, more than 20%"
  else
    echo "delta $(git rev-parse --short "$since")..$(git rev-parse --short HEAD) ($pct% of the diff)"
  fi
}

# --- evidence.json -------------------------------------------------------------

json() {
  [ -f "$dir/gates.tsv" ] || { echo "evidence: run 'evidence gates' first." >&2; return 2; }
  [ -f "$dir/gates.partial" ] && { echo "evidence: the last gates run was partial (--only $(cat "$dir/gates.partial")); run every gate at the final commit." >&2; return 1; }
  head=$(git rev-parse HEAD)
  mb=$(merge_base)
  review=$dir/review.md
  verdict=missing high=0 medium=0 low=0
  if [ -f "$review" ]; then
    high=$(grep -c '\[high\]' "$review")
    medium=$(grep -c '\[medium\]' "$review")
    low=$(grep -c '\[low\]' "$review")
    ready=$(awk '/^## Ready for PR/ { getline; while ($0 ~ /^[[:space:]]*$/) getline; print tolower($1); exit }' "$review")
    case $ready in yes*) verdict=ready ;; no*) verdict=not-ready ;; *) verdict=unknown ;; esac
  fi
  {
    printf '{\n  "branch": %s,\n  "head": %s,\n  "base": %s,\n  "base_sha": %s,\n  "created": %s,\n' \
      "$(json_str "$branch")" "$(json_str "$head")" "$(json_str "$(base_ref)")" "$(json_str "$(git rev-parse "$mb")")" \
      "$(json_str "$(date -u +%Y-%m-%dT%H:%M:%SZ)")"
    printf '  "gates": ['
    awk -F '\t' -v q='"' '
      function s(x) { gsub(/\\/, "\\\\", x); gsub(/"/, "\\\"", x); return q x q }
      { printf "%s\n    {\"name\": %s, \"result\": %s, \"seconds\": %s, \"detail\": %s}", (NR > 1 ? "," : ""), s($1), s($2), $3 + 0, s($4) }
    ' "$dir/gates.tsv"
    printf '\n  ],\n  "criteria": ['
    if [ -f "$dir/matrix.tsv" ]; then
      ls "$dir/screenshots" 2>/dev/null >"$tmp/shots"
      awk -F '\t' -v q='"' -v shots="$tmp/shots" -v data="$dir/data-runs.tsv" '
        function s(x) { gsub(/\\/, "\\\\", x); gsub(/"/, "\\\"", x); return q x q }
        BEGIN {
          while ((getline l < shots) > 0) shot[++ns] = l
          while ((getline l < data) > 0) { split(l, f, "\t"); run[f[1]] = f[2] }
          seeded = ("e2e" in run) ? run["e2e"] : "not configured"
          mocked = ("mocked" in run) ? run["mocked"] : "not configured"
        }
        {
          if (!($1 in seen)) { seen[$1] = 1; order[++n] = $1 }
          cases[$1]++
          if ($4 == "pass" || $4 == "n/a") ok[$1]++
          if ($3 !~ /^n\/a:/ && index(tests[$1], "\t" $3 "\t") == 0) tests[$1] = tests[$1] "\t" $3 "\t"
        }
        END {
          for (i = 1; i <= n; i++) {
            c = order[i]; t = ""; m = split(tests[c], parts, "\t")
            for (j = 1; j <= m; j++) if (parts[j] != "") t = t (t == "" ? "" : ", ") s(parts[j])
            sh = ""
            for (k = 1; k <= ns; k++) if (index(shot[k], c "-") == 1) sh = sh (sh == "" ? "" : ", ") s(shot[k])
            printf "%s\n    {\"id\": %s, \"tests\": [%s], \"edge_cases\": %d, \"edge_cases_passed\": %d, \"screenshots\": [%s], \"seeded\": %s, \"mocked\": %s}", \
              (i > 1 ? "," : ""), s(c), t, cases[c], ok[c] + 0, sh, s(seeded), s(mocked)
          }
        }
      ' "$dir/matrix.tsv"
    fi
    printf '\n  ],\n  "flaky": ['
    [ -s "$dir/flaky.txt" ] && awk -v q='"' '{ gsub(/"/, "\\\""); printf "%s%s%s%s", (NR > 1 ? ", " : ""), q, $0, q }' "$dir/flaky.txt"
    printf '],\n  "review": {"verdict": %s, "high": %d, "medium": %d, "low": %d},\n' "$(json_str "$verdict")" "$high" "$medium" "$low"
    printf '  "screenshots": %s,\n' "$(json_str "$(cat "$dir/screenshots.txt" 2>/dev/null || { [ -d "$dir/screenshots" ] && echo taken; } || echo "not run")")"
    printf '  "usage": "usage.tsv"\n}\n'
  } >"$dir/evidence.json"
  echo "Wrote $dir/evidence.json for $(git rev-parse --short HEAD)."
  if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "Warning: the working tree has uncommitted changes, so the pack does not describe $head exactly. Commit, then verify again." >&2
    return 1
  fi
}

# --- push to kit-evidence ------------------------------------------------------

push() {
  pr=""
  [ "${1:-}" = --pr ] && pr=${2:?--pr needs a number}
  [ -f "$dir/evidence.json" ] || { echo "evidence: run 'evidence json' first." >&2; return 2; }
  head=$(git rev-parse HEAD)
  grep -q "\"head\": \"$head\"" "$dir/evidence.json" || { echo "evidence: evidence.json is not for HEAD ($head); verify again." >&2; return 1; }
  key=${pr:+pr-$pr}
  key=${key:-$(printf '%s' "$branch" | tr -c 'A-Za-z0-9._-' '-')}
  remote=${KIT_EVIDENCE_REMOTE:-origin}
  git fetch -q "$remote" "+refs/heads/kit-evidence:refs/remotes/$remote/kit-evidence" 2>/dev/null
  parent=$(git rev-parse -q --verify "refs/remotes/$remote/kit-evidence" 2>/dev/null)
  # Build the commit with a temporary index, so the working tree and the current branch stay untouched.
  GIT_INDEX_FILE=$tmp/index
  export GIT_INDEX_FILE
  if [ -n "$parent" ]; then git read-tree "$parent"; else git read-tree --empty; fi
  git rm -q -r --cached --ignore-unmatch "$key/$head" >/dev/null
  (cd "$dir" && find . -type f | sed 's|^\./||') | while IFS= read -r f; do
    blob=$(git hash-object -w "$dir/$f")
    git update-index --add --cacheinfo "100644,$blob,$key/$head/$f"
  done
  tree=$(git write-tree)
  unset GIT_INDEX_FILE
  commit=$(git commit-tree "$tree" ${parent:+-p "$parent"} -m "Evidence for $key at $head")
  git push -q "$remote" "$commit:refs/heads/kit-evidence" || return 1
  echo "Pushed the pack to $remote kit-evidence:$key/$head/"
}

# --- CI ------------------------------------------------------------------------

# ci-check --head SHA --key KEY [--key KEY]: exit 0 if a pack for SHA exists under one of the keys and names SHA.
ci_check() {
  head="" keys=""
  while [ $# -gt 0 ]; do
    case $1 in
      --head) head=$2; shift 2 ;;
      --key) keys="$keys $(printf '%s' "$2" | tr -c 'A-Za-z0-9._-' '-')"; shift 2 ;;
      *) echo "evidence ci-check: unknown option $1" >&2; return 2 ;;
    esac
  done
  [ -n "$head" ] && [ -n "$keys" ] || { echo "usage: evidence ci-check --head SHA --key KEY..." >&2; return 2; }
  remote=${KIT_EVIDENCE_REMOTE:-origin}
  git fetch -q "$remote" "+refs/heads/kit-evidence:refs/remotes/$remote/kit-evidence" 2>/dev/null || { echo "No kit-evidence branch: run /verify-feature and push its pack." >&2; return 1; }
  for key in $keys; do
    if json=$(git show "refs/remotes/$remote/kit-evidence:$key/$head/evidence.json" 2>/dev/null); then
      named=$(printf '%s' "$json" | sed -n 's/^ *"head": *"\([0-9a-f]*\)".*/\1/p' | head -n 1)
      if [ "$named" != "$head" ]; then
        echo "The pack under $key/$head names $named, not $head: stale evidence counts as no evidence." >&2
        return 1
      fi
      echo "$key"
      return 0
    fi
  done
  newest=$(git ls-tree --name-only "refs/remotes/$remote/kit-evidence" 2>/dev/null | tr '\n' ' ')
  echo "No evidence pack for $head under:$keys. Packs exist for: ${newest:-nothing}. Stale evidence counts as no evidence: run /verify-feature on this commit." >&2
  return 1
}

# comment --dir DIR --repo OWNER/NAME --key KEY [--ci-data FILE]: the sticky PR comment, inline images from kit-evidence.
comment() {
  cdir="" repo="" key="" ci_data=""
  while [ $# -gt 0 ]; do
    case $1 in
      --dir) cdir=$2; shift 2 ;;
      --repo) repo=$2; shift 2 ;;
      --key) key=$2; shift 2 ;;
      --ci-data) ci_data=$2; shift 2 ;;
      *) echo "evidence comment: unknown option $1" >&2; return 2 ;;
    esac
  done
  [ -f "$cdir/gates.tsv" ] || { echo "evidence comment: no gates.tsv in $cdir" >&2; return 2; }
  head=$(sed -n 's/^ *"head": *"\([0-9a-f]*\)".*/\1/p' "$cdir/evidence.json" | head -n 1)
  echo "<!-- kit-evidence -->"
  echo "## Evidence for ${head:-unknown}"
  echo
  echo "| Gate | Result | Detail |"
  echo "|------|--------|--------|"
  awk -F '\t' '{ gsub(/\|/, "/", $4); printf "| %s | %s | %s |\n", $1, $2, $4 }' "$cdir/gates.tsv"
  if [ -f "$cdir/matrix.tsv" ]; then
    echo
    echo "**Edge cases:** $(awk -F '\t' '$4 == "pass" || $4 == "n/a" { ok++ } END { printf "%d of %d", ok, NR }' "$cdir/matrix.tsv") pass."
    awk -F '\t' '$4 != "pass" && $4 != "n/a" { printf "- %s %s: %s\n", $1, $2, $4 }' "$cdir/matrix.tsv"
  fi
  [ -f "$cdir/evidence.json" ] && sed -n 's/^ *"review": *{"verdict": *"\([^"]*\)", "high": \([0-9]*\), "medium": \([0-9]*\), "low": \([0-9]*\)}.*/\
**Review:** \1, \2 high, \3 medium, \4 low./p' "$cdir/evidence.json"
  if [ -n "$ci_data" ] && [ -f "$ci_data" ]; then
    echo
    echo "**Data runs in CI:** $(awk -F '\t' '{ printf "%s%s %s", (NR > 1 ? ", " : ""), $1, $2 }' "$ci_data")"
  fi
  if [ -d "$cdir/screenshots" ] && [ -n "$(ls "$cdir/screenshots")" ]; then
    echo
    echo "### Screenshots"
    echo
    for path in "$cdir"/screenshots/*.png; do
      f=${path##*/}
      case $f in *.main.png) continue ;; esac
      main=${f%.png}.main.png
      printf '**%s**\n\n' "${f%.png}"
      printf '![%s](https://github.com/%s/blob/kit-evidence/%s/%s/screenshots/%s?raw=true)' "$f" "$repo" "$key" "$head" "$f"
      [ -f "$cdir/screenshots/$main" ] && printf ' ![%s](https://github.com/%s/blob/kit-evidence/%s/%s/screenshots/%s?raw=true)' "$main" "$repo" "$key" "$head" "$main"
      printf '\n\n'
    done
  fi
}

command=${1:-}
[ $# -gt 0 ] && shift
case $command in
  gates) gates "$@" ;;
  scope) scope "$@" ;;
  matrix) matrix ;;
  data) data "$@" ;;
  e2e-select) e2e_select "$@" ;;
  screenshots) screenshots "$@" ;;
  json) json ;;
  push) push "$@" ;;
  ci-check) ci_check "$@" ;;
  comment) comment "$@" ;;
  *) sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
